  <section class="section" id="curve">
    <div class="rvl wrap curve">
      <div class="copy">
        <p class="eyebrow" style="margin-bottom:16px">Forward curve</p>
        <h2 class="display" style="font-size:clamp(32px,3.8vw,48px)">A term structure for compute.</h2>
        <p class="lede" style="margin-top:16px;max-width:36ch">Every delivery quarter is its own market.</p>
        <div class="chips" id="curveChips"><button class="on" data-c="GPU">GPU</button><button data-c="VCPU">vCPU</button><button data-c="RAM">RAM</button><button data-c="BLK">Storage</button><button data-c="BW">Network</button></div>
        <div class="curve-read">
          <div><div class="k">Spot</div><div class="v num" id="crSpot">1.02</div></div>
          <div><div class="k">Q1 2028</div><div class="v num" id="crFar">0.86</div></div>
          <div><div class="k">Shape</div><div class="v" id="crShape">Backwardation</div></div>
          <div><div class="k">Implied 12m</div><div class="v num down" id="crImp">−15.7%</div></div>
        </div>
      </div>
      <div class="plot">
        <svg id="curveSvg" viewBox="0 0 760 420" role="img" aria-label="Forward curve"></svg>
        <div class="tip" id="curveTip"></div>
      </div>
    </div>
  </section>

